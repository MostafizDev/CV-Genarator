# Firebase Web App config (Firebase console -> Project Settings -> General -> Your apps).
# Safe to expose client-side -- Firebase's security model is rule/Admin-SDK-based, not
# key-secrecy-based.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Only needed if the frontend is served separately from the backend (see README).
# VITE_API_BASE=https://your-backend.example.com/api
